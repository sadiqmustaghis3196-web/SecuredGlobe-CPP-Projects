QWidget { font-family: 'Segoe UI', 'Arial', sans-serif; font-size: 13px; color: #1d3448; }
QMainWindow, QDialog { background: #f5f7f9; }
QWidget#sidebar { background: #101f30; }
QLabel#brand { color: white; font-size: 19px; font-weight: 700; padding-bottom: 20px; }
QLabel#sidebarNote { color: #93abb8; font-size: 10px; }
QPushButton { background: white; border: 1px solid #dce5e9; border-radius: 6px; padding: 10px 16px; text-align: center; }
QPushButton:hover { background: #eaf5f1; border-color: #83b3a6; }
QPushButton:focus { border: 2px solid #218575; }
QPushButton#nav { background: transparent; color: #b1c0cc; border: none; text-align: left; padding: 10px 12px; }
QPushButton#nav:hover { color: white; background: #1c786d; }
QPushButton#primary { color: white; background: #177e70; border: 1px solid #177e70; }
QPushButton#primary:hover { background: #116556; }
QPushButton:disabled { color: #9caab5; background: #edf0f2; }
QLabel#pageTitle { font-size: 27px; font-weight: 700; padding: 16px 0; }
QLabel#muted { color: #80929f; font-size: 12px; }
QLabel#error { color: #b85349; }
QLabel#statCard { background: white; border: 1px solid #e3e9ed; border-radius: 10px; padding: 22px; font-size: 19px; font-weight: 600; }
QLineEdit, QComboBox, QSpinBox, QDateEdit { border: 1px solid #dce5e9; border-radius: 5px; padding: 9px; background: white; min-height: 20px; }
QLineEdit:focus, QComboBox:focus { border-color: #1c8a78; }
QTableWidget { background: white; alternate-background-color: #f8fafb; border: 1px solid #e2e9ed; border-radius: 6px; gridline-color: #edf1f3; selection-background-color: #e0f2eb; selection-color: #1b6355; min-height: 240px; }
QTableWidget::item { padding: 10px; }
QHeaderView::section { background: #f1f5f7; color: #6e8492; padding: 12px 9px; border: none; border-bottom: 1px solid #dce5e9; font-weight: 600; }
QTextBrowser { background: white; border: 1px solid #e3e9ed; padding: 20px; }
QScrollArea { background: transparent; }
